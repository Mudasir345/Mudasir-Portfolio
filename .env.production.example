# ==============================================================
# PORTFOLIO PROJECT — PRODUCTION ENVIRONMENT EXAMPLE
# ==============================================================
# Copy this file to `.env.production` and fill in your real values
# NEVER commit the actual `.env.production` file with real secrets
# ==============================================================

# ─── Database (Aiven MySQL Production) ─────────────────────────
# Aiven Cloud MySQL Database for Production
DATABASE_URL=mysql://avnadmin:YOUR_PASSWORD@mysql-1a089c81-mudasirchoudhry345-352d.a.aivencloud.com:13153/defaultdb?ssl-mode=REQUIRED

# ─── Admin Panel Authentication ────────────────────────────────
# IMPORTANT: Use strong, unique values for production
ADMIN_PASSWORD=your-strong-production-password-here
ADMIN_SESSION_SECRET=your-32-character-random-secret-here

# ─── Primary Contact Delivery (Web3Forms) ──────────────────────
# Web3Forms access key for contact form submissions
NEXT_PUBLIC_WEB3FORMS_KEY=your-web3forms-access-key

# ─── Email Where Inquiries Are Delivered ───────────────────────
# Email address that will RECEIVE contact form submissions
CONTACT_EMAIL=your-email@example.com

# ─── Secondary Contact Delivery (Gmail SMTP via Nodemailer) ────
# Gmail credentials for backup email delivery
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-gmail-app-password

# ─── WhatsApp Link ──────────────────────────────────────────────
# WhatsApp contact link
NEXT_PUBLIC_WHATSAPP=https://wa.me/92300000000000

# ─── Cloudinary — Media Storage (Images & Videos) ──────────────
# Cloudinary credentials for media storage
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# ─── Public Site URL (Production) ──────────────────────────────
# Update this with your actual Vercel deployment URL
NEXT_PUBLIC_SITE_URL=https://your-vercel-app-url.vercel.app