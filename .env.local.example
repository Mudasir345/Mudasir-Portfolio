# ==============================================================
# PORTFOLIO PROJECT — FULL ENVIRONMENT CONFIGURATION
# ==============================================================
# Copy this file to `.env.local` and fill in your real values.
# NEVER commit `.env.local` or `.env` to version control.
# ==============================================================

# ─── Database ──────────────────────────────────────────────────
# Local development MySQL OR remote (Aiven, PlanetScale, etc.)
# Example: mysql://user:password@host:3306/database_name
DATABASE_URL=mysql://root:@127.0.0.1:3306/portfolio_db

# ─── Admin Panel Authentication ────────────────────────────────
# Login password for /admin page. Use a STRONG password.
ADMIN_PASSWORD=your-strong-admin-password-here

# At least 32 characters. Generate with:  openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# ─── Primary Contact Delivery (Web3Forms) ──────────────────────
# Sign up FREE at https://web3forms.com/ to get an access key.
# This is the EASIEST way — no SMTP / Gmail setup needed.
NEXT_PUBLIC_WEB3FORMS_KEY=your-web3forms-access-key

# ─── Email Where Inquiries Are Delivered ───────────────────────
# Email address that will RECEIVE contact form submissions.
CONTACT_EMAIL=you@example.com

# ─── Secondary Contact Delivery (Gmail SMTP via Nodemailer) ────
# Used ONLY if Web3Forms fails. Leave blank if you don't use it.
# Gmail Instructions:
#   1. Turn ON 2-Step Verification on your Google Account
#   2. Visit https://myaccount.google.com/apppasswords
#   3. Create an App Password for "Mail" (16 chars, NO spaces)
EMAIL_USER=you@gmail.com
EMAIL_PASS=your-16-character-gmail-app-password

# ─── WhatsApp Link (shown on Hero + Contact + Fallback CTA) ────
# Generate wa.me link: https://wa.me/92300123456789 (country code + number, NO + / -)
NEXT_PUBLIC_WHATSAPP=https://wa.me/92300000000000

# ─── Cloudinary — Media Storage (Images & Videos) ──────────────
# Dashboard: https://cloudinary.com/console
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# ─── Public Site URL (used for SEO OG images + canonical) ──────
# Example: https://mudasirch.netlify.app  or  https://your-domain.com
NEXT_PUBLIC_SITE_URL=https://your-domain.com
