# Admin Panel Password
# IMPORTANT: Change this to a secure, strong password before deploying!
ADMIN_PASSWORD=change_this_to_a_strong_password_123

# Email Configuration (Gmail Nodemailer)
# To set this up:
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Go to App Passwords page: https://myaccount.google.com/apppasswords
# 3. Select 'Mail' and 'Other (Custom name)' (e.g., 'Portfolio Contact Form')
# 4. Generate and copy the 16-character password (without spaces)
# 5. Fill both EMAIL_USER and EMAIL_PASS below:
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-16-character-gmail-app-password
